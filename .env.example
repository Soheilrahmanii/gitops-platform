# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_your_token_here
GITHUB_ORG=your-org-or-username
GITHUB_TEMPLATE_REPO=your-org/app-template

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_URL=http://localhost:3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ── Application ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
